---
let inventory = [];
let products = [];
let error = null;

try {
  const [resInv, resProd] = await Promise.all([
    fetch("http://localhost:3000/api/inventory"),
    fetch("http://localhost:3000/api/products")
  ]);
  const dataInv = await resInv.json();
  const dataProd = await resProd.json();
  
  if (dataInv && dataInv.ok) inventory = dataInv.inventory || [];
  if (dataProd && dataProd.ok) products = dataProd.products || [];
} catch (e) {
  error = "No se pudieron cargar los datos para las métricas.";
}

const threeMonthsAgo = new Date();
threeMonthsAgo.setMonth(threeMonthsAgo.getMonth() - 3);

const costMap = {};
inventory.forEach(inv => {
  const invDate = new Date(inv.purchaseDate);
  const name = inv.productName;
  const price = parseFloat(inv.unitaryPrice);
  
  if (!costMap[name]) costMap[name] = { cost: price, date: invDate };
  
  if (invDate >= threeMonthsAgo) {
    if (price > costMap[name].cost) {
      costMap[name].cost = price;
      costMap[name].date = invDate;
    }
  }
});

const profitData = products.map(p => {
  const name = p.name;
  const salePrice = parseFloat(p.price);
  const cost = costMap[name] ? costMap[name].cost : 0;
  const absoluteProfit = salePrice - cost;
  const margin = salePrice > 0 ? (absoluteProfit / salePrice) * 100 : 0;
  
  return {
    name,
    cost,
    salePrice,
    absoluteProfit,
    margin
  };
});

let topMarginProduct = { name: "N/A", margin: -Infinity, absoluteProfit: 0 };
let topProfitProduct = { name: "N/A", margin: 0, absoluteProfit: -Infinity };
let lowestMarginProduct = { name: "N/A", margin: Infinity, absoluteProfit: 0 };
let lowestProfitProduct = { name: "N/A", margin: 0, absoluteProfit: Infinity };

if (profitData.length > 0) {
  profitData.forEach(d => {
    if (d.margin > topMarginProduct.margin) topMarginProduct = d;
    if (d.absoluteProfit > topProfitProduct.absoluteProfit) topProfitProduct = d;
    if (d.margin < lowestMarginProduct.margin) lowestMarginProduct = d;
    if (d.absoluteProfit < lowestProfitProduct.absoluteProfit) lowestProfitProduct = d;
  });
}

if (profitData.length === 0) {
  topMarginProduct.margin = 0;
  topProfitProduct.absoluteProfit = 0;
  lowestMarginProduct.margin = 0;
  lowestProfitProduct.absoluteProfit = 0;
}
---

{error ? (
  <div class="bg-red-50 text-red-500 p-4 rounded-lg border border-red-200 mb-8 text-sm">
    {error}
  </div>
) : (
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    
    <!-- Métrica 1: Top Margen % -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center relative overflow-hidden">
      <div class="absolute inset-0 bg-green-50 opacity-40"></div>
      <div class="relative z-10">
        <h4 class="text-xs font-medium text-green-700 uppercase tracking-wider mb-1">Mayor Margen (%)</h4>
        <span class="text-xl font-bold text-gray-900 block truncate" title={topMarginProduct.name}>{topMarginProduct.name}</span>
        <span class="text-sm font-bold text-green-700">{topMarginProduct.margin.toFixed(1)}% de utilidad</span>
      </div>
    </div>

    <!-- Métrica 2: Top Ganancia $ -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center relative overflow-hidden">
      <div class="absolute inset-0 bg-emerald-50 opacity-40"></div>
      <div class="relative z-10">
        <h4 class="text-xs font-medium text-emerald-700 uppercase tracking-wider mb-1">Mayor Ganancia ($)</h4>
        <span class="text-xl font-bold text-gray-900 block truncate" title={topProfitProduct.name}>{topProfitProduct.name}</span>
        <span class="text-sm font-bold text-emerald-700">+${topProfitProduct.absoluteProfit.toFixed(2)} por unidad</span>
      </div>
    </div>

    <!-- Métrica 3: Peor Margen % -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center relative overflow-hidden">
      <div class="absolute inset-0 bg-red-50 opacity-30"></div>
      <div class="relative z-10">
        <h4 class="text-xs font-medium text-red-700 uppercase tracking-wider mb-1">Menor Margen (%)</h4>
        <span class="text-xl font-bold text-gray-900 block truncate" title={lowestMarginProduct.name}>{lowestMarginProduct.name}</span>
        <span class="text-sm font-bold text-red-700">{lowestMarginProduct.margin.toFixed(1)}% de utilidad</span>
      </div>
    </div>

    <!-- Métrica 4: Peor Ganancia $ -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center relative overflow-hidden">
      <div class="absolute inset-0 bg-orange-50 opacity-30"></div>
      <div class="relative z-10">
        <h4 class="text-xs font-medium text-orange-700 uppercase tracking-wider mb-1">Menor Ganancia ($)</h4>
        <span class="text-xl font-bold text-gray-900 block truncate" title={lowestProfitProduct.name}>{lowestProfitProduct.name}</span>
        <span class="text-sm font-bold text-orange-700">+${lowestProfitProduct.absoluteProfit.toFixed(2)} por unidad</span>
      </div>
    </div>

  </div>
)}
