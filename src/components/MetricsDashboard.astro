---
let tickets = [];
let error = null;

try {
  const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/tickets`);
  const data = await res.json();
  if (data && data.ok) {
    tickets = data.tickets || [];
  }
} catch (e) {
  error = "No se pudieron cargar las métricas.";
}

// Calcular métricas para los últimos 30 días
const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

let revenue = 0;
let productsSold = 0;
let ticketCount = 0;

tickets.forEach((ticket) => {
  const ticketDate = new Date(ticket.created_at);
  
  if (ticketDate >= thirtyDaysAgo) {
    revenue += parseFloat(ticket.finalPrice || 0);
    ticketCount += 1;
    if (ticket.products) {
      ticket.products.forEach((p) => {
        productsSold += p.quantity;
      });
    }
  }
});

const averageTicket = ticketCount > 0 ? revenue / ticketCount : 0;
const averagePerDay = revenue / 30;
---

{error ? (
  <div class="bg-red-50 text-red-500 p-4 rounded-lg border border-red-200 mb-8 text-sm">
    {error}
  </div>
) : (
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    
    <!-- Métrica 1: Ingresos del último mes -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center">
      <h4 class="text-sm font-medium text-gray-500 mb-1">Ingresos (Últimos 30 días)</h4>
      <span class="text-3xl font-bold text-gray-900">${revenue.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
    </div>

    <!-- Métrica 2: Productos Vendidos -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center">
      <h4 class="text-sm font-medium text-gray-500 mb-1">Productos Vendidos</h4>
      <span class="text-3xl font-bold text-gray-900">{productsSold.toLocaleString('es-MX')} <span class="text-base font-normal text-gray-400">artículos</span></span>
    </div>

    <!-- Métrica 3: Ticket Promedio -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center">
      <h4 class="text-sm font-medium text-gray-500 mb-1">Ticket Promedio</h4>
      <span class="text-3xl font-bold text-gray-900">${averageTicket.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
    </div>

    <!-- Métrica 4: Promedio Diario -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center relative overflow-hidden">
      <!-- Un fondito sutil azul para destacarla como pediste -->
      <div class="absolute inset-0 bg-blue-50 opacity-50"></div>
      <div class="relative z-10">
        <h4 class="text-sm font-medium text-blue-600 mb-1">Promedio por Día</h4>
        <span class="text-3xl font-bold text-blue-900">${averagePerDay.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>
      </div>
    </div>

  </div>
)}
