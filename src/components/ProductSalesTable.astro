---
let tickets = [];
let error = null;

try {
  const res = await fetch(`${import.meta.env.PUBLIC_API_URL}/api/tickets`);
  const data = await res.json();
  if (data && data.ok) {
    tickets = data.tickets || [];
  }
} catch (e) {
  error = "No se pudieron cargar las ventas de productos.";
}

// Desplegar todos los productos vendidos de forma individual para la tabla
const allSales = [];

tickets.forEach((ticket) => {
  if (ticket.products) {
    ticket.products.forEach((p) => {
      allSales.push({
        date: ticket.created_at,
        ticketId: ticket.idTicketLocal,
        productName: p.productName,
        category: p.categoryName || "Sin categoría",
        quantity: p.quantity,
        total: parseFloat(p.total || 0),
        unitPrice: parseFloat(p.unitaryPrice || 0),
      });
    });
  }
});

// Ordenar por fecha más reciente
allSales.sort((a, b) => new Date(b.date) - new Date(a.date));

const uniqueProducts = Array.from(new Set(allSales.map((s) => s.productName))).sort();
---

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div class="flex items-center gap-3">
      <h3 class="text-lg font-medium text-gray-900">Historial de Salidas (Ventas)</h3>
      <span class="bg-green-100 text-green-800 text-xs font-semibold px-2.5 py-0.5 rounded-full" id="sales-count">{allSales.length} Movimientos</span>
    </div>
    
    <div class="flex items-center gap-2">
      <label for="filter-sales-product" class="text-sm font-medium text-gray-700">Producto:</label>
      <select id="filter-sales-product" class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full sm:w-64 p-2 outline-none">
        <option value="all">Todos los productos</option>
        {uniqueProducts.map((prod) => (
          <option value={prod}>{prod}</option>
        ))}
      </select>
    </div>
  </div>
  
  {error ? (
    <div class="p-6 text-center text-red-500">{error}</div>
  ) : allSales.length === 0 ? (
    <div class="p-6 text-center text-gray-500">No hay registros de salidas.</div>
  ) : (
    <div class="overflow-x-auto max-h-[500px]">
      <table class="w-full text-sm text-left text-gray-600 relative">
        <thead class="text-xs text-gray-700 uppercase bg-gray-100 sticky top-0 shadow-sm">
          <tr>
            <th scope="col" class="px-6 py-3">Fecha de Salida</th>
            <th scope="col" class="px-6 py-3">Producto</th>
            <th scope="col" class="px-6 py-3 text-center">Cant.</th>
            <th scope="col" class="px-6 py-3 text-right">P. Venta</th>
            <th scope="col" class="px-6 py-3 text-right">Total</th>
          </tr>
        </thead>
        <tbody id="sales-tbody">
          {allSales.map((sale) => (
            <tr class="border-b border-gray-200 hover:bg-gray-50 sale-row transition-colors" data-product={sale.productName}>
              <td class="px-6 py-4 whitespace-nowrap text-gray-500">
                {new Date(sale.date).toLocaleString()}
                <div class="text-[10px] text-gray-400 mt-1">Ticket: {sale.ticketId.substring(0, 8)}</div>
              </td>
              <td class="px-6 py-4 font-medium text-gray-900">
                {sale.productName}
                <div class="text-xs text-gray-500 font-normal mt-0.5">{sale.category}</div>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded-full border border-gray-200">
                  {sale.quantity}
                </span>
              </td>
              <td class="px-6 py-4 text-right text-gray-500">
                ${sale.unitPrice.toFixed(2)}
              </td>
              <td class="px-6 py-4 text-right font-medium text-gray-900">
                ${sale.total.toFixed(2)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const salesFilter = document.getElementById('filter-sales-product');
    const salesRows = document.querySelectorAll('.sale-row');
    const salesCountBadge = document.getElementById('sales-count');

    if (salesFilter) {
      salesFilter.addEventListener('change', (e) => {
        const selectedProd = e.target.value;
        let visibleCount = 0;
        
        salesRows.forEach(row => {
          const prod = row.getAttribute('data-product');
          if (selectedProd === 'all' || prod === selectedProd) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });
        
        if (salesCountBadge) {
          salesCountBadge.textContent = `${visibleCount} Movimientos`;
        }
      });
    }
  });
</script>
