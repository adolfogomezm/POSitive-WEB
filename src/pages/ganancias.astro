---
import Layout from "../layouts/Layout.astro";
import ProfitMetrics from "../components/ProfitMetrics.astro";
import ProfitChart from "../components/ProfitChart.astro";
import ProfitTable from "../components/ProfitTable.astro";
---

<Layout>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 mb-6">Salud Financiera y Ganancias</h1>

      <!-- Métricas inteligentes destacadas -->
      <ProfitMetrics />

      <div class="space-y-8">
        <!-- Gráfica mensual de utilidad neta -->
        <ProfitChart />
        
        <!-- Tabla ordenable del catálogo de productos (Márgenes y Ganancias) -->
        <ProfitTable />
      </div>
    </div>
  </main>
</Layout>
