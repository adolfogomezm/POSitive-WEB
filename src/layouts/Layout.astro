---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Show, UserButton, SignInButton } from "@clerk/astro/components";
import POSIChat from "../components/POSIChat.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>POSitive</title>
		<ClientRouter />
	</head>
	<body>
		<div class="h-screen flex flex-col">
			<header
				class="pl-8 pr-10 border-b border-gray-300 flex justify-between items-center bg-white shadow-sm"
			>
				<img src="/Logo.png" alt="Logo" class="h-15 w-auto" />
				<div class="flex items-center gap-4">
					<nav class="flex gap-4">
						<a href="/" class="text-gray-600 hover:text-gray-900 font-medium text-sm">Inicio</a>
						<a href="/ventas" class="text-gray-600 hover:text-gray-900 font-medium text-sm">Ventas</a>
						<a href="/productos" class="text-gray-600 hover:text-gray-900 font-medium text-sm">Productos</a>
						<a href="/ganancias" class="text-gray-600 hover:text-gray-900 font-medium text-sm">Ganancias</a>
					</nav>
					<Show when="signed-out">
						<SignInButton />
					</Show>
					<Show when="signed-in">
						<UserButton />
					</Show>
				</div>
			</header>
			<div class="flex-1 overflow-y-auto">
			    <slot />
			</div>
		</div>
		
		<POSIChat />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
